codex
The worklog helper exists under the actual vault path, but its default `VaultRoot` expression fails because `$PSScriptRoot` is empty in this invocation. I’m reading the script header and rerunning it with an explicit vault root parameter if supported.
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "Get-Content -TotalCount 80 'C:\\Users\\jewoo\\Obsidian\\ObsidianVault\\scripts\\codex_worklog.ps1'" in C:\Users\jewoo\Desktop\adie
 succeeded in 214ms:
param(
  [Parameter(Mandatory = $true)]
  [string]$Title,

  [Parameter(Mandatory = $true)]
  [string]$Summary,

  [string]$Project = "",

  [string]$VaultRoot = (Split-Path -Parent $PSScriptRoot)
)

$ErrorActionPreference = "Stop"

$logPath = Join-Path $VaultRoot "wiki\log.md"
$todayPath = Join-Path $VaultRoot "wiki\Today.md"

if (-not (Test-Path -LiteralPath $logPath)) {
  throw "Missing Obsidian log path: $logPath"
}

$timestamp = Get-Date -Format "yyyy-MM-dd HH:mm"
$projectText = if ($Project.Trim().Length -gt 0) { " | Project: $Project" } else { "" }
$entry = "`n- $timestamp [codex] $Title$projectText - $Summary"
Add-Content -LiteralPath $logPath -Value $entry -Encoding UTF8

if (Test-Path -LiteralPath $todayPath) {
  $todayContent = Get-Content -LiteralPath $todayPath -Raw -Encoding UTF8
  $marker = "## 5. Outstanding follow-ups"
  $todayLine = "- $timestamp Codex: $Title$projectText"
  if ($todayContent -notmatch [regex]::Escape($todayLine)) {
    if ($todayContent.Contains($marker)) {
      $todayContent = $todayContent.Replace($marker, "$todayLine`n`n$marker")
      Set-Content -LiteralPath $todayPath -Value $todayContent -Encoding UTF8
    }
  }
}

Write-Output "Logged Codex work to $logPath"


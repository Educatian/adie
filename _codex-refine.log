"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
from pathlib import Path
from PIL import Image

root = Path('assets/img')
gen_dir = Path(r'C:\\Users\\jewoo\\.codex\\generated_images\\019e57c8-4731-7673-abaf-0ceefb2727fd')

def resize_to_max(img, max_w=None, max_h=None):
    w, h = img.size
    scale = 1.0
    if max_w and w > max_w:
        scale = min(scale, max_w / w)
    if max_h and h > max_h:
        scale = min(scale, max_h / h)
    if scale < 1.0:
        return img.resize((round(w * scale), round(h * scale)), Image.Resampling.LANCZOS)
    return img

def save_webp(src_name, out_name, max_w=None, quality=78):
    with Image.open(root / src_name) as img:
        img = resize_to_max(img.convert('RGB'), max_w=max_w)
        img.save(root / out_name, 'WEBP', quality=quality, method=6)
        print(f'{out_name}: {img.size[0]}x{img.size[1]}')

def save_png_optimized(src_path, out_path, max_w=None, max_h=None, colors=None):
    with Image.open(src_path) as img:
        img = resize_to_max(img.convert('RGB'), max_w=max_w, max_h=max_h)
        if colors:
            img = img.quantize(colors=colors, method=Image.Quantize.MEDIANCUT).convert('P')
        img.save(out_path, 'PNG', optimize=True, compress_level=9)
        print(f'{out_path.name}: {img.size[0]}x{img.size[1]}')

save_webp('background-mesh.png', 'background-mesh.webp', max_w=1600, quality=76)
save_webp('hero-key-visual.png', 'hero-key-visual.webp', max_w=1800, quality=78)
save_webp('og-image.png', 'og-image.webp', max_w=1800, quality=78)
for name in ['motif-immersive', 'motif-analytics', 'motif-inclusive', 'motif-genai', 'motif-stem']:
    save_webp(f'{name}.png', f'{name}.webp', max_w=1000, quality=78)

for idx, src in enumerate(sorted(gen_dir.glob('*.png'), key=lambda p: p.stat().st_mtime), start=1):
    save_png_optimized(src, root / f'avatar-tile-{idx}.png', max_w=600, max_h=600, colors=192)

save_png_optimized(root / 'favicon.png', root / 'favicon.png', max_w=256, max_h=256, colors=128)
save_png_optimized(root / 'addie-monogram.png', root / 'addie-monogram.png', max_w=512, max_h=512, colors=128)
with Image.open(root / 'moon-headshot.jpg') as img:
    img = resize_to_max(img.convert('RGB'), max_w=900, max_h=900)
    img.save(root / 'moon-headshot.jpg', 'JPEG', quality=82, optimize=True, progressive=True)
    print(f'moon-headshot.jpg: {img.size[0]}x{img.size[1]}')

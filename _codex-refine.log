.grant-column > h3 {
  margin: 0 0 4px;
  font-family: var(--font-mono);
  font-size: 0.82rem;
  color: var(--crimson);
  text-transform: uppercase;
}

.grant-card {
  padding: 18px;
}

.grant-card .amount {
  display: inline-block;
  margin-top: 12px;
  color: var(--crimson);
  font-family: var(--font-display);
  font-size: 1.6rem;
  font-weight: 700;
}

.join {
  padding-bottom: clamp(80px, 10vw, 130px);
}

.join-panel {
  display: grid;
  grid-template-columns: 0.9fr 1fr;
  gap: clamp(28px, 6vw, 76px);
  padding: clamp(26px, 5vw, 58px);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background:
    linear-gradient(135deg, color-mix(in srgb, var(--surface-strong) 88%, transparent), var(--surface)),
    url("assets/img/background-mesh.png");
  background-size: cover;
  box-shadow: var(--shadow);
}

.contact-list {
  display: grid;
  gap: 12px;
  margin: 28px 0 0;
  padding: 0;
  list-style: none;
}

.contact-list li {
  display: grid;
  gap: 3px;
}

.contact-list strong {
  color: var(--crimson);
  font-family: var(--font-mono);
  font-size: 0.72rem;
  text-transform: uppercase;
}

.contact-list a,
.contact-list span {
  color: var(--muted);
}

.contact-form {
  display: grid;
  gap: 14px;
}

.contact-form label {
  display: grid;
  gap: 7px;
  color: var(--muted);
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 800;
  text-transform: uppercase;
}

.contact-form input,
.contact-form textarea {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: color-mix(in srgb, var(--surface-strong) 86%, transparent);
  color: var(--ink);
  padding: 13px 14px;
  resize: vertical;
}

.form-note {
  margin: 0;
  color: var(--muted);
  font-size: 0.82rem;
}

.site-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 32px 0 44px;
  color: var(--muted);
  border-top: 1px solid var(--line);
}

.site-footer strong,
.site-footer span {
  display: block;
}

.site-footer strong {
  color: var(--ink);
}

.reveal {
  opacity: 1;
  transform: none;
}

.reveal.is-visible {
  animation: reveal-in 650ms ease both;
}

.delay-1 {
  animation-delay: 120ms;
}

.delay-2 {
  animation-delay: 220ms;
}

@keyframes reveal-in {
  from {
    opacity: 0;
    transform: translateY(22px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 1040px) {
  .hero-inner,
  .mission-grid,
  .constellation,
  .join-panel {
    grid-template-columns: 1fr;
  }

  .hero-inner {
    gap: 20px;
  }

  .hero-copy {
    padding-bottom: 0;
  }

  .research-grid,
  .people-grid,
  .collab-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .research-card {
    min-height: 330px;
  }

  .publication-grid,
  .project-rail,
  .grant-summary {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 760px) {
  :root {
    --container: min(100vw - 28px, 1180px);
  }

  .site-header {
    inset: 10px 14px auto;
    width: calc(100vw - 28px);
    grid-template-columns: auto auto auto;
  }

  .brand small {
    display: none;
  }

  .nav-toggle {
    display: inline-grid;
  }

  .site-nav {
    position: fixed;
    inset: 72px 14px auto;
    display: none;
    grid-column: 1 / -1;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-strong);
    box-shadow: var(--shadow);
  }

  .site-nav.is-open {
    display: grid;
  }

  .site-nav a {
    padding: 12px;
  }

  .hero {
    min-height: auto;
    padding-top: 118px;
  }

  h1 {
    font-size: clamp(2.62rem, 12vw, 4.05rem);
  }

  .hero-stats,
  .publication-grid,
  .project-rail,
  .grant-summary,
  .grant-columns {
    grid-template-columns: 1fr;
  }

  .research-grid,
  .people-grid,
  .collab-grid {
    grid-template-columns: 1fr;
  }

  .publication-row {
    grid-template-columns: 58px 1fr;
  }

  .publication-row .chips {
    grid-column: 2;
  }

  .site-footer {
    align-items: flex-start;
    flex-direction: column;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }

  .reveal {
    opacity: 1;
    transform: none;
  }
}



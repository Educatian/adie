const { chromium } = require('./tmp/adie-pw/node_modules/playwright');
const fs = require('fs');

(async () => {
  const browser = await chromium.launch({ headless: true });
  const results = {};
  const errors = [];
  const warnings = [];
  const page = await browser.newPage({ viewport: { width: 1440, height: 1100 } });
  page.on('console', msg => {
    if (msg.type() === 'error') errors.push(msg.text());
    if (msg.type() === 'warning') warnings.push(msg.text());
  });
  page.on('pageerror', err => errors.push(err.message));
  await page.goto('http://127.0.0.1:4173/', { waitUntil: 'networkidle' });
  await page.waitForTimeout(1200);
  results.url = page.url();
  results.title = await page.title();
  results.bodyTextLength = (await page.locator('body').innerText()).length;
  results.heroVisible = await page.locator('h1').filter({ hasText: 'Adaptive Design' }).isVisible();
  results.peopleCards = await page.locator('.person-card').count();
  results.monogramAvatars = await page.locator('.person-avatar.is-monogram').count();
  results.photoAvatars = await page.locator('.person-avatar.is-photo').count();
  results.avatarTilesLoaded = await page.evaluate(() => Promise.all(Array.from(document.querySelectorAll('.person-avatar.is-monogram')).map(async el => {
    const bg = getComputedStyle(el).getPropertyValue('--avatar-image');
    const match = bg.match(/url\\([\"']?(.+?)[\"']?\\)/);
    if ("'!match) return false;
    const img = new Image();
    img.src = match[1];
    await img.decode().catch(() => null);
    return img.naturalWidth > 0;
  })).then(values => values.every(Boolean)));
  results.directorHasXR = await page.locator('"'.person-card').filter({ hasText: 'Dr. Jewoong Moon' }).locator('.chip', { hasText: 'XR' }).count();
  results.publicationLinks = await page.locator('.publication-link').evaluateAll(nodes => nodes.map(a => a.href));
  results.publicationLinksAllValid = results.publicationLinks.every(href => /"'^https?:'"\\/\\//.test(href));
  results.constellationNodes = await page.locator('#constellation-viz circle').count();
  results.constellationLinks = await page.locator('#constellation-viz line').count();
  results.constellationLabels = await page.locator('#constellation-viz text').count();
  await page.locator('[data-tag=\"XR\"]').click();
  await page.waitForTimeout(250);
  results.xrFilterActive = await page.locator('[data-tag=\"XR\"]').evaluate(el => el.classList.contains('is-active'));
  results.xrRows = await page.locator('.publication-row').count();
  await page.evaluate(() => window.scrollTo(0, document.body.scrollHeight));
  await page.waitForTimeout(250);
  results.backToTopVisible = await page.locator('[data-back-to-top]').evaluate(el => getComputedStyle(el).opacity === '1');
  await page.locator('[data-back-to-top]').click();
  await page.waitForTimeout(500);
  results.backToTopScrolled = await page.evaluate(() => window.scrollY < 120);
  await page.screenshot({ path: 'tmp/adie-desktop.png', fullPage: false });

  const mobile = await browser.newPage({ viewport: { width: 390, height: 900 }, isMobile: true });
  const mobileErrors = [];
  mobile.on('console', msg => { if (msg.type() === 'error') mobileErrors.push(msg.text()); });
  mobile.on('pageerror', err => mobileErrors.push(err.message));
  await mobile.goto('http://127.0.0.1:4173/', { waitUntil: 'networkidle' });
  await mobile.waitForTimeout(1000);
  results.mobileTitle = await mobile.title();
  results.mobileNavButtonVisible = await mobile.locator('.nav-toggle').isVisible();
  await mobile.locator('.nav-toggle').click();
  results.mobileNavOpened = await mobile.locator('.site-nav.is-open').isVisible();
  results.mobilePeopleGridOneColumn = await mobile.locator('.people-grid').first().evaluate(el => getComputedStyle(el).gridTemplateColumns.split(' ').length === 1);
  results.mobileHeroVisible = await mobile.locator('h1').isVisible();
  await mobile.screenshot({ path: 'tmp/adie-mobile.png', fullPage: false });
  results.errors = errors;
  results.warnings = warnings;
  results.mobileErrors = mobileErrors;
  await browser.close();
  fs.writeFileSync('tmp/adie-qa-results.json', JSON.stringify(results, null, 2));
  console.log(JSON.stringify(results, null, 2));
})().catch(err => {
  console.error(err);
  process.exit(1);
});
